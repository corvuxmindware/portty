<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- iroh's DNS resolver / network monitor reads ConnectivityManager; without
         this it logs "Neither user … has android.permission.ACCESS_NETWORK_STATE"
         and falls back to Google DNS. Normal (install-time) permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- QR pairing scans the host's QR with the back camera (see QrScanner.tsx).
         wry's onPermissionRequest raises the OS runtime prompt for VIDEO_CAPTURE,
         but Android silently denies a request for an undeclared permission - so
         this line is what makes the camera prompt actually appear. Camera is not
         required (the ticket can be pasted instead), so the app still installs on
         camera-less devices like AndroidTV. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Push doorbell: Android 13+ requires a runtime prompt before the OS
         shows notifications at all. MainActivity asks at launch, but only when
         Firebase is actually configured - a build without google-services.json
         keeps push off and never shows the prompt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.portty_app"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM half of the push doorbell. Registered unconditionally; without
             a google-services.json the Firebase SDK never initializes and the
             service never receives anything. -->
        <service
            android:name=".PorttyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
