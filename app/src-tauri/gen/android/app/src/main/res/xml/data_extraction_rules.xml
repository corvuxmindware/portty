<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup/transfer policy.
     Nothing Portty keeps may leave the phone: the device identity and
     reconnect credentials (a copied identity is a copied credential), the
     WebView storage holding the approval log and "always allow" rules, saved
     host names, and the push wake key. Tauri's data dir on Android is the app's
     root data directory, so the `root` domain holds most of it - every domain is
     excluded, the device-protected `device_*` ones too, from BOTH cloud backup
     and device-to-device transfer. `allowBackup="false"` covers older APIs; on
     Android 12+ it no longer stops device-to-device transfer, which is why
     this file has to list every domain. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
